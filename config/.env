APP_NAME=Neko Tunneling API
APP_KEY=__APP_KEY__
APP_ADDR=127.0.0.1:3000

LOG_LEVEL=info
LOG_FORMAT=text

CACHE_IP_PATH=/var/lib/nekotun/cache/ip
CACHE_DOMAIN_PATH=/var/lib/nekotun/cache/domain
CACHE_ISP_PATH=/var/lib/nekotun/cache/isp
CACHE_CITY_PATH=/var/lib/nekotun/cache/city

DB_PATH=/var/lib/nekotun/sqlite.db

CERT_FILE=/etc/nekotun/certs/fullchain.cer
KEY_FILE=/etc/nekotun/certs/private.key

DROPBEAR_ADDR=127.0.0.1:90
OPENSSH_ADDR=127.0.0.1:22
XRAY_API_ADDR=127.0.0.1:62789
XRAY_VMESS_CONF_PATH=/etc/xray/conf.d/002-quantix.json
XRAY_VLESS_CONF_PATH=/etc/xray/conf.d/003-spectrum.json
XRAY_TROJAN_CONF_PATH=/etc/xray/conf.d/004-cipheron.json